{
  "version": 2,
  "name": "scrapwell-dashboard",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/client/css/(.*)",
      "destination": "/css/$1"
    },
    {
      "source": "/client/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/client/(.*)",
      "destination": "/$1"
    }
  ]
}
